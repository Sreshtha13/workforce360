// ============================================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  MATERNITY
  PATERNITY
  UNPAID
  COMPENSATORY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  date           DateTime         @db.Date
  checkIn        DateTime?        @map("check_in")
  checkOut       DateTime?        @map("check_out")
  status         AttendanceStatus @default(PRESENT)
  hours          Decimal?         @db.Decimal(4, 2)
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  user           User             @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("attendance_records")
}

model LeavePolicy {
  id                  String           @id @default(cuid())
  leaveType           LeaveType        @map("leave_type")
  name                String
  annualQuota         Int              @map("annual_quota")
  carryForward        Boolean          @default(false) @map("carry_forward")
  maxCarryForward     Int?             @map("max_carry_forward")
  requiresApproval    Boolean          @default(true) @map("requires_approval")
  applicableToAll     Boolean          @default(true) @map("applicable_to_all")
  description         String?
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  leaveApplications   LeaveApplication[]

  @@map("leave_policies")
}

model LeaveApplication {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  policyId       String        @map("policy_id")
  startDate      DateTime      @db.Date @map("start_date")
  endDate        DateTime      @db.Date @map("end_date")
  days           Decimal       @db.Decimal(4, 1)
  reason         String?
  status         LeaveStatus   @default(PENDING)
  appliedAt      DateTime      @default(now()) @map("applied_at")
  reviewedAt     DateTime?     @map("reviewed_at")
  reviewedById   String?       @map("reviewed_by_id")
  reviewNotes    String?       @map("review_notes")
  approvalRequestId String?    @unique @map("approval_request_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  user           User          @relation("UserLeaveApplications", fields: [userId], references: [id], onDelete: Cascade)
  policy         LeavePolicy   @relation(fields: [policyId], references: [id])
  reviewedBy     User?         @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])

  @@index([userId])
  @@index([policyId])
  @@index([status])
  @@index([startDate])
  @@map("leave_applications")
}

model TimesheetEntry {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  projectId      String?   @map("project_id")
  taskId         String?   @map("task_id")
  date           DateTime  @db.Date
  hours          Decimal   @db.Decimal(4, 2)
  description    String?
  billable       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user           User      @relation("UserTimesheets", fields: [userId], references: [id], onDelete: Cascade)
  project        Project?  @relation(fields: [projectId], references: [id])
  task           Task?     @relation(fields: [taskId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([date])
  @@map("timesheet_entries")
}

// ============================================================================
// PHASE 4: FINANCE & PAYROLL
// ============================================================================

enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  CASH
  CHEQUE
  ONLINE
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PayrollRunStatus {
  DRAFT
  CALCULATING
  CALCULATED
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  PROCESSED
  PAID
  FAILED
}

model FinanceClient {
  id                String    @id @default(cuid())
  name              String
  email             String?
  phone             String?
  company           String?
  address           String?
  city              String?
  state             String?
  country           String?
  postalCode        String?   @map("postal_code")
  taxId             String?   @map("tax_id")
  paymentTerms      Int       @default(30) @map("payment_terms")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  invoices          Invoice[]

  @@map("finance_clients")
}

model Invoice {
  id                String        @id @default(cuid())
  clientId          String        @map("client_id")
  invoiceNumber     String        @unique @map("invoice_number")
  issueDate         DateTime      @db.Date @map("issue_date")
  dueDate           DateTime      @db.Date @map("due_date")
  status            InvoiceStatus @default(DRAFT)
  subtotal          Decimal       @db.Decimal(12, 2)
  taxAmount         Decimal       @default(0) @db.Decimal(12, 2) @map("tax_amount")
  total             Decimal       @db.Decimal(12, 2)
  amountPaid        Decimal       @default(0) @db.Decimal(12, 2) @map("amount_paid")
  currency          String        @default("USD")
  notes             String?
  terms             String?
  submittedAt       DateTime?     @map("submitted_at")
  approvedAt        DateTime?     @map("approved_at")
  sentAt            DateTime?     @map("sent_at")
  approvalRequestId String?       @unique @map("approval_request_id")
  createdById       String        @map("created_by_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  client            FinanceClient @relation(fields: [clientId], references: [id])
  createdBy         User          @relation("InvoiceCreator", fields: [createdById], references: [id])
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])
  lineItems         InvoiceLineItem[]
  payments          Payment[]

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLineItem {
  id             String    @id @default(cuid())
  invoiceId      String    @map("invoice_id")
  description    String
  quantity       Decimal   @db.Decimal(10, 2)
  unitPrice      Decimal   @db.Decimal(12, 2) @map("unit_price")
  amount         Decimal   @db.Decimal(12, 2)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id             String        @id @default(cuid())
  invoiceId      String        @map("invoice_id")
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  reference      String?
  notes          String?
  paidAt         DateTime      @db.Date @map("paid_at")
  createdById    String        @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy      User          @relation("PaymentRecorder", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
  @@map("payments")
}

model Reimbursement {
  id             String               @id @default(cuid())
  userId         String               @map("user_id")
  amount         Decimal              @db.Decimal(12, 2)
  currency       String               @default("USD")
  category       String
  description    String
  receiptFileId  String?              @map("receipt_file_id")
  status         ReimbursementStatus  @default(PENDING)
  submittedAt    DateTime             @default(now()) @map("submitted_at")
  reviewedAt     DateTime?            @map("reviewed_at")
  reviewedById   String?              @map("reviewed_by_id")
  paidAt         DateTime?            @map("paid_at")
  notes          String?
  approvalRequestId String?           @unique @map("approval_request_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  deletedAt      DateTime?            @map("deleted_at")

  user           User                 @relation("UserReimbursements", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy     User?                @relation("ReimbursementReviewer", fields: [reviewedById], references: [id])
  receiptFile    StoredFile?          @relation("ReimbursementReceipt", fields: [receiptFileId], references: [id])
  approvalRequest ApprovalRequest?    @relation(fields: [approvalRequestId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
  @@map("reimbursements")
}

model SalaryStructure {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  effectiveFrom  DateTime  @db.Date @map("effective_from")
  effectiveTo    DateTime? @db.Date @map("effective_to")
  currency       String    @default("USD")
  isActive       Boolean   @default(true) @map("is_active")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  components     SalaryComponent[]
  payslips       Payslip[]

  @@index([userId])
  @@index([effectiveFrom])
  @@index([isActive])
  @@map("salary_structures")
}

model SalaryComponent {
  id             String          @id @default(cuid())
  structureId    String          @map("structure_id")
  name           String
  type           String
  amount         Decimal         @db.Decimal(12, 2)
  isFixed        Boolean         @default(true) @map("is_fixed")
  isTaxable      Boolean         @default(true) @map("is_taxable")
  sortOrder      Int             @default(0) @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  structure      SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId])
  @@map("salary_components")
}

model PayrollRun {
  id             String           @id @default(cuid())
  title          String
  period         String
  startDate      DateTime         @db.Date @map("start_date")
  endDate        DateTime         @db.Date @map("end_date")
  status         PayrollRunStatus @default(DRAFT)
  totalEmployees Int              @default(0) @map("total_employees")
  totalGross     Decimal          @default(0) @db.Decimal(14, 2) @map("total_gross")
  totalNet       Decimal          @default(0) @db.Decimal(14, 2) @map("total_net")
  calculatedAt   DateTime?        @map("calculated_at")
  approvedAt     DateTime?        @map("approved_at")
  processedAt    DateTime?        @map("processed_at")
  paidAt         DateTime?        @map("paid_at")
  approvalRequestId String?       @unique @map("approval_request_id")
  createdById    String           @map("created_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  createdBy      User             @relation("PayrollRunCreator", fields: [createdById], references: [id])
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])
  payslips       Payslip[]

  @@index([status])
  @@index([startDate])
  @@index([createdById])
  @@map("payroll_runs")
}

model Payslip {
  id             String          @id @default(cuid())
  runId          String          @map("run_id")
  userId         String          @map("user_id")
  structureId    String          @map("structure_id")
  period         String
  workingDays    Int             @map("working_days")
  paidDays       Int             @map("paid_days")
  lopDays        Int             @default(0) @map("lop_days")
  grossSalary    Decimal         @db.Decimal(12, 2) @map("gross_salary")
  deductions     Decimal         @db.Decimal(12, 2)
  netSalary      Decimal         @db.Decimal(12, 2) @map("net_salary")
  fileId         String?         @map("file_id")
  isPublished    Boolean         @default(false) @map("is_published")
  publishedAt    DateTime?       @map("published_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  run            PayrollRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  structure      SalaryStructure @relation(fields: [structureId], references: [id])
  file           StoredFile?     @relation("PayslipPDF", fields: [fileId], references: [id])

  @@unique([runId, userId])
  @@index([runId])
  @@index([userId])
  @@index([isPublished])
  @@map("payslips")
}

// ============================================================================
// GENERIC APPROVAL WORKFLOW ENGINE (Phase 3 + Phase 9 hardening)
// ============================================================================

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalActionType {
  APPROVE
  REJECT
  REQUEST_CHANGES
  CANCEL
  DELEGATE
  ESCALATE
}

model ApprovalWorkflow {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  entityType  String    @map("entity_type") // leave_application | invoice | payroll_run | reimbursement | support_ticket
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  levels      ApprovalWorkflowLevel[]
  conditions  ApprovalWorkflowCondition[]
  requests    ApprovalRequest[]

  @@index([entityType])
  @@index([isActive])
  @@map("approval_workflows")
}

model ApprovalWorkflowLevel {
  id                 String   @id @default(cuid())
  workflowId         String   @map("workflow_id")
  level              Int
  /// Prefer role-based routing when set (resolved at request creation time).
  approverRoleCode   String?  @map("approver_role_code")
  /// Fixed approver override (optional).
  approverUserId     String?  @map("approver_user_id")
  escalateAfterHours Int?     @map("escalate_after_hours")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workflow           ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, level])
  @@index([workflowId])
  @@map("approval_workflow_levels")
}

model ApprovalWorkflowCondition {
  id         String   @id @default(cuid())
  workflowId String   @map("workflow_id")
  /// Metadata field path, e.g. "amount" or "priority"
  field      String
  /// eq | ne | gt | gte | lt | lte | in
  operator   String
  value      String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  workflow   ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("approval_workflow_conditions")
}

model ApprovalDelegation {
  id          String    @id @default(cuid())
  delegatorId String    @map("delegator_id")
  delegateId  String    @map("delegate_id")
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime  @map("ends_at")
  reason      String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  delegator   User      @relation("DelegationDelegator", fields: [delegatorId], references: [id])
  delegate    User      @relation("DelegationDelegate", fields: [delegateId], references: [id])

  @@index([delegatorId])
  @@index([delegateId])
  @@index([startsAt, endsAt])
  @@map("approval_delegations")
}

model ApprovalRequest {
  id            String                @id @default(cuid())
  entityType    String                @map("entity_type")
  entityId      String                @map("entity_id")
  requesterId   String                @map("requester_id")
  workflowId    String?               @map("workflow_id")
  currentLevel  Int                   @default(1) @map("current_level")
  totalLevels   Int                   @default(1) @map("total_levels")
  status        ApprovalRequestStatus @default(PENDING)
  metadata      Json?
  dueAt         DateTime?             @map("due_at")
  completedAt   DateTime?             @map("completed_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  deletedAt     DateTime?             @map("deleted_at")

  requester     User                  @relation("ApprovalRequester", fields: [requesterId], references: [id])
  workflow      ApprovalWorkflow?     @relation(fields: [workflowId], references: [id])
  steps         ApprovalStep[]
  actions       ApprovalAction[]
  leaveApplications LeaveApplication[]
  invoices      Invoice[]
  payrollRuns   PayrollRun[]
  reimbursements Reimbursement[]
  supportTickets SupportTicket[]

  @@index([entityType, entityId])
  @@index([status])
  @@index([requesterId])
  @@index([dueAt])
  @@map("approval_requests")
}

model ApprovalStep {
  id                String                @id @default(cuid())
  approvalRequestId String                @map("approval_request_id")
  level             Int
  approverId        String                @map("approver_id")
  status            ApprovalRequestStatus @default(PENDING)
  assignedAt        DateTime              @default(now()) @map("assigned_at")
  respondedAt       DateTime?             @map("responded_at")
  notes             String?
  dueAt             DateTime?             @map("due_at")
  delegatedFromId   String?               @map("delegated_from_id")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  approvalRequest   ApprovalRequest       @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approver          User                  @relation("StepApprover", fields: [approverId], references: [id])
  delegatedFrom     User?                 @relation("StepDelegatedFrom", fields: [delegatedFromId], references: [id])

  @@unique([approvalRequestId, level])
  @@index([approvalRequestId])
  @@index([approverId])
  @@index([status])
  @@map("approval_steps")
}

model ApprovalAction {
  id                String             @id @default(cuid())
  approvalRequestId String             @map("approval_request_id")
  actorId           String             @map("actor_id")
  actionType        ApprovalActionType @map("action_type")
  level             Int
  notes             String?
  timestamp         DateTime           @default(now())
  createdAt         DateTime           @default(now()) @map("created_at")

  approvalRequest   ApprovalRequest    @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  actor             User               @relation("ApprovalActionActor", fields: [actorId], references: [id])

  @@index([approvalRequestId])
  @@index([actorId])
  @@map("approval_actions")
}

// ============================================================================
// DOCUMENT MANAGEMENT SYSTEM (Phase 9)
// ============================================================================

enum DocumentContext {
  EMPLOYEE
  CANDIDATE
  PROJECT
  GENERAL
}

enum DocumentAccessLevel {
  VIEW
  EDIT
  DELETE
  MANAGE
}

model DocumentCategory {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  description String?
  context     DocumentContext?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  documents   ManagedDocument[]

  @@map("document_categories")
}

model ManagedDocument {
  id               String           @id @default(cuid())
  title            String
  description      String?
  categoryId       String?          @map("category_id")
  context          DocumentContext  @default(GENERAL)
  contextEntityId  String?          @map("context_entity_id")
  currentVersionId String?          @unique @map("current_version_id")
  createdById      String           @map("created_by_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  category         DocumentCategory? @relation(fields: [categoryId], references: [id])
  createdBy        User              @relation("DocumentCreator", fields: [createdById], references: [id])
  currentVersion   DocumentVersion?  @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id])
  versions         DocumentVersion[] @relation("DocumentVersions")
  permissions      DocumentPermission[]

  @@index([context, contextEntityId])
  @@index([categoryId])
  @@index([createdById])
  @@map("managed_documents")
}

model DocumentVersion {
  id            String           @id @default(cuid())
  documentId    String           @map("document_id")
  versionNumber Int              @map("version_number")
  fileId        String           @map("file_id")
  changeNotes   String?          @map("change_notes")
  uploadedById  String           @map("uploaded_by_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")

  document      ManagedDocument  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor    ManagedDocument? @relation("CurrentDocumentVersion")
  file          StoredFile       @relation(fields: [fileId], references: [id])
  uploadedBy    User             @relation("DocumentVersionUploader", fields: [uploadedById], references: [id])

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([fileId])
  @@map("document_versions")
}

model DocumentPermission {
  id          String              @id @default(cuid())
  documentId  String              @map("document_id")
  userId      String?             @map("user_id")
  roleCode    String?             @map("role_code")
  accessLevel DocumentAccessLevel @map("access_level")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")

  document    ManagedDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User?               @relation("DocumentPermissionUser", fields: [userId], references: [id])

  @@index([documentId])
  @@index([userId])
  @@index([roleCode])
  @@map("document_permissions")
}

// ============================================================================
// PHASE 7: DEVELOPMENT & QA MODULE
// ============================================================================

enum ReleaseStatus {
  PLANNING
  IN_PROGRESS
  TESTING
  STAGING
  RELEASED
  ROLLED_BACK
}

enum ReleaseType {
  MAJOR
  MINOR
  PATCH
  HOTFIX
}

enum TestCaseStatus {
  DRAFT
  READY
  PASSED
  FAILED
  BLOCKED
  SKIPPED
}

enum TestCasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

model Release {
  id                String        @id @default(cuid())
  projectId         String        @map("project_id")
  version           String
  name              String
  type              ReleaseType   @default(MINOR)
  status            ReleaseStatus @default(PLANNING)
  description       String?
  releaseDate       DateTime?     @map("release_date")
  deployedAt        DateTime?     @map("deployed_at")
  deployedById      String?       @map("deployed_by_id")
  releaseNotes      String?       @map("release_notes")
  tagName           String?       @map("tag_name")
  commitHash        String?       @map("commit_hash")
  buildNumber       String?       @map("build_number")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployedBy        User?         @relation("ReleaseDeployer", fields: [deployedById], references: [id])
  tasks             Task[]        @relation("ReleaseTask")
  testCases         TestCase[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([status])
  @@index([releaseDate])
  @@map("releases")
}

model TestCase {
  id             String           @id @default(cuid())
  projectId      String           @map("project_id")
  releaseId      String?          @map("release_id")
  title          String
  description    String?
  steps          String?
  expectedResult String?          @map("expected_result")
  status         TestCaseStatus   @default(DRAFT)
  priority       TestCasePriority @default(MEDIUM)
  assignedToId   String?          @map("assigned_to_id")
  createdById    String           @map("created_by_id")
  executedAt     DateTime?        @map("executed_at")
  executedById   String?          @map("executed_by_id")
  actualResult   String?          @map("actual_result")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  release        Release?         @relation(fields: [releaseId], references: [id])
  assignedTo     User?            @relation("TestCaseAssignee", fields: [assignedToId], references: [id])
  createdBy      User             @relation("TestCaseCreator", fields: [createdById], references: [id])
  executedBy     User?            @relation("TestCaseExecutor", fields: [executedById], references: [id])

  @@index([projectId])
  @@index([releaseId])
  @@index([status])
  @@index([assignedToId])
  @@map("test_cases")
}

model Documentation {
  id             String    @id @default(cuid())
  projectId      String?   @map("project_id")
  title          String
  description    String?
  category       String?
  url            String?
  content        String?
  version        String?
  isPublished    Boolean   @default(false) @map("is_published")
  publishedAt    DateTime? @map("published_at")
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  project        Project?  @relation(fields: [projectId], references: [id])
  createdBy      User      @relation("DocumentationCreator", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([category])
  @@index([isPublished])
  @@map("documentations")
}

model TechTraining {
  id             String    @id @default(cuid())
  title          String
  description    String?
  category       String?
  content        String?
  url            String?
  duration       Int?
  isRequired     Boolean   @default(false) @map("is_required")
  isActive       Boolean   @default(true) @map("is_active")
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  createdBy      User      @relation("TrainingCreator", fields: [createdById], references: [id])
  enrollments    TrainingEnrollment[]

  @@index([category])
  @@index([isActive])
  @@map("tech_trainings")
}

model TrainingEnrollment {
  id             String         @id @default(cuid())
  trainingId     String         @map("training_id")
  userId         String         @map("user_id")
  status         TrainingStatus @default(NOT_STARTED)
  enrolledAt     DateTime       @default(now()) @map("enrolled_at")
  startedAt      DateTime?      @map("started_at")
  completedAt    DateTime?      @map("completed_at")
  score          Int?
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  training       TechTraining   @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId])
  @@index([trainingId])
  @@index([userId])
  @@index([status])
  @@map("training_enrollments")
}

model CodeReview {
  id             String    @id @default(cuid())
  taskId         String?   @map("task_id")
  projectId      String    @map("project_id")
  title          String
  description    String?
  pullRequestUrl String?   @map("pull_request_url")
  authorId       String    @map("author_id")
  reviewerId     String?   @map("reviewer_id")
  status         String    @default("PENDING")
  reviewNotes    String?   @map("review_notes")
  requestedAt    DateTime  @default(now()) @map("requested_at")
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  task           Task?     @relation(fields: [taskId], references: [id])
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author         User      @relation("CodeReviewAuthor", fields: [authorId], references: [id])
  reviewer       User?     @relation("CodeReviewer", fields: [reviewerId], references: [id])

  @@index([taskId])
  @@index([projectId])
  @@index([authorId])
  @@index([reviewerId])
  @@index([status])
  @@map("code_reviews")
}

// ============================================================================
// PHASE 10: REPORTING & SCHEDULED REPORTS
// ============================================================================

enum ReportType {
  ATTENDANCE
  LEAVE
  RECRUITMENT
  INVOICE
  PAYROLL
  PROJECT
  EXECUTIVE
}

enum ReportFormat {
  CSV
  PDF
}

enum ReportScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model ReportSchedule {
  id             String                   @id @default(cuid())
  name           String
  reportType     ReportType               @map("report_type")
  format         ReportFormat             @default(CSV)
  frequency      ReportScheduleFrequency  @default(WEEKLY)
  /// Cron-like day: for WEEKLY = 0-6 (Sun-Sat); for MONTHLY = 1-28; unused for DAILY
  dayOfPeriod    Int?                     @map("day_of_period")
  /// Hour 0-23 in server local/UTC
  hourUtc        Int                      @default(8) @map("hour_utc")
  recipients     String[]                 @default([])
  filters        Json?
  isActive       Boolean                  @default(true) @map("is_active")
  lastRunAt      DateTime?                @map("last_run_at")
  nextRunAt      DateTime?                @map("next_run_at")
  createdById    String                   @map("created_by_id")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  deletedAt      DateTime?                @map("deleted_at")

  createdBy      User                     @relation("ReportScheduleCreator", fields: [createdById], references: [id])

  @@index([reportType])
  @@index([isActive])
  @@index([nextRunAt])
  @@map("report_schedules")
}

// ============================================================================
// PHASE 11: ADMIN — TEMPLATES & SYSTEM SETTINGS
// ============================================================================

model NotificationTemplate {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  channel     String    @default("EMAIL") // EMAIL | IN_APP
  subject     String?
  body        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  updatedById String?   @map("updated_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  updatedBy   User?     @relation("NotificationTemplateUpdater", fields: [updatedById], references: [id])

  @@index([channel])
  @@map("notification_templates")
}

model SystemSetting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  category    String    @default("general")
  description String?
  isSecret    Boolean   @default(false) @map("is_secret")
  updatedById String?   @map("updated_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  updatedBy   User?     @relation("SystemSettingUpdater", fields: [updatedById], references: [id])

  @@index([category])
  @@map("system_settings")
}

// ============================================================================
// PHASE 12: SECURITY — MFA, DEVICES, ALERTS
// ============================================================================

model UserMfa {
  id            String    @id @default(cuid())
  userId        String    @unique @map("user_id")
  secret        String
  enabled       Boolean   @default(false)
  backupCodes   String[]  @default([]) @map("backup_codes")
  enforcedByRole Boolean  @default(false) @map("enforced_by_role")
  verifiedAt    DateTime? @map("verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

model TrustedDevice {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  deviceHash     String    @map("device_hash")
  label          String?
  userAgent      String?   @map("user_agent")
  ipAddress      String?   @map("ip_address")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  refreshTokenId String?   @map("refresh_token_id")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@index([userId])
  @@index([revokedAt])
  @@map("trusted_devices")
}

model SecurityEvent {
  id          String    @id @default(cuid())
  userId      String?   @map("user_id")
  eventType   String    @map("event_type") // FAILED_LOGIN | PERMISSION_DENIED | MFA_FAILURE | SUSPICIOUS
  severity    String    @default("INFO") // INFO | WARN | CRITICAL
  message     String
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User?     @relation("SecurityEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
  @@map("security_events")
}

/// Roles that require MFA when this flag is set on Role (via SystemSetting mfa.enforce_role_codes or Role.requiresMfa)
/// Soft extension: add requiresMfa on Role without breaking existing rows.

