// Workforce 360 ERP — Prisma schema (API-only)
// Migrations live in /db/migrations. Never access this from /apps/web.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SYSTEM & HEALTH
// ============================================================================

model HealthProbe {
  id        String    @id @default(cuid())
  label     String    @default("ok")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("health_probes")
}

// ============================================================================
// ORGANIZATION STRUCTURE
// ============================================================================

model Company {
  id             String    @id @default(cuid())
  name           String
  legalName      String?   @map("legal_name")
  registrationNo String?   @unique @map("registration_no")
  taxId          String?   @unique @map("tax_id")
  email          String?
  phone          String?
  website        String?
  logo           String?
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?   @map("postal_code")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  departments Department[]
  offices     Office[]

  @@map("companies")
}

model Department {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  name        String
  code        String?
  description String?
  managerId   String?   @map("manager_id")
  parentId    String?   @map("parent_id")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager           User?              @relation("DepartmentManager", fields: [managerId], references: [id])
  parent            Department?        @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children          Department[]       @relation("DepartmentHierarchy")
  teams             Team[]
  users             User[]
  designations      Designation[]
  jobPostings       JobPosting[]
  policyAssignments PolicyAssignment[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([managerId])
  @@index([parentId])
  @@map("departments")
}

model Team {
  id           String    @id @default(cuid())
  departmentId String    @map("department_id")
  name         String
  code         String?
  description  String?
  leadId       String?   @map("lead_id")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department        Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lead              User?              @relation("TeamLead", fields: [leadId], references: [id])
  members           TeamMember[]
  policyAssignments PolicyAssignment[]

  @@unique([departmentId, code])
  @@index([departmentId])
  @@index([leadId])
  @@map("teams")
}

model TeamMember {
  id        String    @id @default(cuid())
  teamId    String    @map("team_id")
  userId    String    @map("user_id")
  role      String?
  joinedAt  DateTime  @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Designation {
  id           String    @id @default(cuid())
  departmentId String    @map("department_id")
  name         String
  code         String?
  level        Int
  /// Approved position capacity for this title (vacant = headcount − assigned users).
  headcount    Int       @default(1)
  description  String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department  Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users       User[]
  jobPostings JobPosting[]

  @@unique([departmentId, code])
  @@index([departmentId])
  @@map("designations")
}

model Office {
  id         String    @id @default(cuid())
  companyId  String    @map("company_id")
  name       String
  code       String?
  type       String?
  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String?   @map("postal_code")
  phone      String?
  email      String?
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users   User[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("offices")
}

model EmployeeType {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users User[]

  @@map("employee_types")
}

model EmploymentStatus {
  id          String    @id @default(cuid())
  /// Workforce status: Active, On Probation, On Leave, Notice Period, Suspended, Terminated
  name        String    @unique
  code        String?   @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users User[]

  @@map("employment_statuses")
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String?   @map("password_hash")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  phone              String?
  avatar             String?
  /// Account lifecycle: active | inactive | blocked | deleted
  status             String    @default("active")
  employeeId         String?   @unique @map("employee_id")
  dateOfBirth        DateTime? @map("date_of_birth")
  dateOfJoining      DateTime? @map("date_of_joining")
  departmentId       String?   @map("department_id")
  designationId      String?   @map("designation_id")
  officeId           String?   @map("office_id")
  employeeTypeId     String?   @map("employee_type_id")
  employmentStatusId String?   @map("employment_status_id")
  managerId          String?   @map("manager_id")
  emailVerified      Boolean   @default(false) @map("email_verified")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  googleId           String?   @unique @map("google_id")
  lastLoginAt        DateTime? @map("last_login_at")
  /// Bumped to invalidate all JWTs (password change, admin force logout, token reuse).
  sessionVersion     Int       @default(0) @map("session_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  department       Department?       @relation(fields: [departmentId], references: [id])
  designation      Designation?      @relation(fields: [designationId], references: [id])
  office           Office?           @relation(fields: [officeId], references: [id])
  employeeType     EmployeeType?     @relation(fields: [employeeTypeId], references: [id])
  employmentStatus EmploymentStatus? @relation(fields: [employmentStatusId], references: [id])
  manager          User?             @relation("UserReportsTo", fields: [managerId], references: [id])
  subordinates     User[]            @relation("UserReportsTo")

  managedDepartments Department[]    @relation("DepartmentManager")
  ledTeams           Team[]          @relation("TeamLead")
  teamMemberships    TeamMember[]
  userRoles          UserRole[]
  refreshTokens      RefreshToken[]
  loginHistory       LoginHistory[]
  auditLogs          AuditLog[]
  passwordResets     PasswordReset[]

  candidateProfile         Candidate?
  employeeMaster           Employee?
  conductedInterviews      Interview[]             @relation("InterviewInterviewer")
  publishedPolicies        CompanyPolicy[]         @relation("PolicyPublisher")
  policyAssignments        PolicyAssignment[]      @relation("PolicyAssignmentTargetUser")
  policyAssignmentsCreated PolicyAssignment[]      @relation("PolicyAssignmentCreator")
  policyAcknowledgements   PolicyAcknowledgement[]
  notifications            Notification[]
  supportTickets           SupportTicket[]         @relation("TicketRequester")
  assignedTickets          SupportTicket[]         @relation("TicketAssignee")
  ticketMessages           SupportTicketMessage[]
  uploadedFiles            StoredFile[]            @relation("FileUploader")

  @@index([email])
  @@index([departmentId])
  @@index([managerId])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  isRevoked Boolean   @default(false) @map("is_revoked")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  status    String
  method    String
  timestamp DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
  @@map("login_history")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  isUsed    Boolean   @default(false) @map("is_used")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

// ============================================================================
// RBAC
// ============================================================================

model Role {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String?   @unique
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  /// Top-level category: Administration, Organization, etc.
  module      String    @default("General")
  /// Human-readable feature label within the module
  feature     String?
  resource    String
  action      String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  rolePermissions RolePermission[]

  @@index([resource])
  @@index([action])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  assignedBy String?   @map("assigned_by")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  timestamp DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ============================================================================
// RECRUITMENT & HR (Phase 2)
// ============================================================================

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum CandidatePipelineStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferLetterStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum EmployeeLifecycleState {
  PRE_ONBOARDING
  ONBOARDING
  ACTIVE
  OFFBOARDING
  TERMINATED
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PolicyAssignmentTarget {
  ALL
  USER
  DEPARTMENT
  TEAM
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_EMPLOYEE
  RESOLVED
  CLOSED
}

enum SupportTicketMessageAuthor {
  EMPLOYEE
  STAFF
  SYSTEM
}

enum StoredFilePurpose {
  RESUME
  POLICY
  OFFER_LETTER
  DOCUMENT
  RECEIPT
  PAYSLIP
  OTHER
}

model StoredFile {
  id           String            @id @default(cuid())
  storageKey   String            @unique @map("storage_key")
  originalName String            @map("original_name")
  mimeType     String            @map("mime_type")
  sizeBytes    Int               @map("size_bytes")
  purpose      StoredFilePurpose @default(OTHER)
  uploadedById String?           @map("uploaded_by_id")
  entityType   String?           @map("entity_type")
  entityId     String?           @map("entity_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  uploadedBy            User?                  @relation("FileUploader", fields: [uploadedById], references: [id])
  candidateResumes      Candidate[]            @relation("CandidateResume")
  offerLetters          OfferLetter[]
  policies              CompanyPolicy[]
  supportTickets        SupportTicket[]
  ticketMessages        SupportTicketMessage[]
  reimbursementReceipts Reimbursement[]
  payslipFiles          Payslip[]

  @@index([uploadedById])
  @@index([entityType, entityId])
  @@map("stored_files")
}

model JobPosting {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  description    String
  requirements   String?
  departmentId   String?          @map("department_id")
  designationId  String?          @map("designation_id")
  location       String?
  employmentType String?          @map("employment_type")
  status         JobPostingStatus @default(DRAFT)
  publishedAt    DateTime?        @map("published_at")
  closedAt       DateTime?        @map("closed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  department   Department?      @relation(fields: [departmentId], references: [id])
  designation  Designation?     @relation(fields: [designationId], references: [id])
  applications JobApplication[]

  @@index([status])
  @@index([departmentId])
  @@map("job_postings")
}

model Candidate {
  id             String                  @id @default(cuid())
  userId         String?                 @unique @map("user_id")
  email          String                  @unique
  firstName      String                  @map("first_name")
  lastName       String                  @map("last_name")
  phone          String?
  linkedInUrl    String?                 @map("linkedin_url")
  resumeFileId   String?                 @map("resume_file_id")
  pipelineStatus CandidatePipelineStatus @default(APPLIED) @map("pipeline_status")
  notes          String?
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  deletedAt      DateTime?               @map("deleted_at")

  user         User?            @relation(fields: [userId], references: [id])
  resumeFile   StoredFile?      @relation("CandidateResume", fields: [resumeFileId], references: [id])
  applications JobApplication[]
  employee     Employee?

  @@index([pipelineStatus])
  @@map("candidates")
}

model JobApplication {
  id           String                  @id @default(cuid())
  candidateId  String                  @map("candidate_id")
  jobPostingId String                  @map("job_posting_id")
  status       CandidatePipelineStatus @default(APPLIED)
  coverLetter  String?                 @map("cover_letter")
  appliedAt    DateTime                @default(now()) @map("applied_at")
  statusNotes  String?                 @map("status_notes")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  deletedAt    DateTime?               @map("deleted_at")

  candidate      Candidate                    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosting     JobPosting                   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  interviews     Interview[]
  assessments    Assessment[]
  offerLetters   OfferLetter[]
  checklistItems PreOnboardingChecklistItem[]

  @@unique([candidateId, jobPostingId])
  @@index([status])
  @@index([candidateId])
  @@index([jobPostingId])
  @@map("job_applications")
}

model Interview {
  id              String          @id @default(cuid())
  applicationId   String          @map("application_id")
  scheduledAt     DateTime        @map("scheduled_at")
  durationMinutes Int             @default(60) @map("duration_minutes")
  location        String?
  meetingLink     String?         @map("meeting_link")
  interviewerId   String?         @map("interviewer_id")
  status          InterviewStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer User?          @relation("InterviewInterviewer", fields: [interviewerId], references: [id])

  @@index([applicationId])
  @@index([interviewerId])
  @@index([scheduledAt])
  @@map("interviews")
}

model Assessment {
  id            String    @id @default(cuid())
  applicationId String    @map("application_id")
  title         String
  description   String?
  dueAt         DateTime? @map("due_at")
  completedAt   DateTime? @map("completed_at")
  score         Float?
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("assessments")
}

model OfferLetter {
  id            String            @id @default(cuid())
  applicationId String            @map("application_id")
  salary        Decimal?          @db.Decimal(12, 2)
  currency      String            @default("USD")
  startDate     DateTime?         @map("start_date")
  content       String
  status        OfferLetterStatus @default(DRAFT)
  fileId        String?           @map("file_id")
  sentAt        DateTime?         @map("sent_at")
  acceptedAt    DateTime?         @map("accepted_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  file        StoredFile?    @relation(fields: [fileId], references: [id])

  @@index([applicationId])
  @@index([status])
  @@map("offer_letters")
}

model PreOnboardingChecklistItem {
  id            String    @id @default(cuid())
  applicationId String    @map("application_id")
  title         String
  isRequired    Boolean   @default(true) @map("is_required")
  isCompleted   Boolean   @default(false) @map("is_completed")
  completedAt   DateTime? @map("completed_at")
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("pre_onboarding_checklist_items")
}

/// Atomic counter for EMP### employee ID generation (single row, id = "default").
model EmployeeIdSequence {
  id        String   @id @default("default")
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employee_id_sequences")
}

model Employee {
  id                    String                 @id @default(cuid())
  userId                String                 @unique @map("user_id")
  candidateId           String?                @unique @map("candidate_id")
  employeeCode          String                 @unique @map("employee_code")
  lifecycleState        EmployeeLifecycleState @default(PRE_ONBOARDING) @map("lifecycle_state")
  hiredAt               DateTime               @default(now()) @map("hired_at")
  terminatedAt          DateTime?              @map("terminated_at")
  emergencyContactName  String?                @map("emergency_contact_name")
  emergencyContactPhone String?                @map("emergency_contact_phone")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")

  user             User                     @relation(fields: [userId], references: [id])
  candidate        Candidate?               @relation(fields: [candidateId], references: [id])
  lifecycleEvents  EmployeeLifecycleEvent[]
  assignedAssets   Asset[]
  reimbursements   Reimbursement[]
  salaryStructures SalaryStructure[]
  salaryRevisions  SalaryRevision[]
  payrollRunItems  PayrollRunItem[]
  payslips         Payslip[]

  @@index([lifecycleState])
  @@map("employees")
}

model EmployeeLifecycleEvent {
  id          String                  @id @default(cuid())
  employeeId  String                  @map("employee_id")
  fromState   EmployeeLifecycleState? @map("from_state")
  toState     EmployeeLifecycleState  @map("to_state")
  notes       String?
  changedById String?                 @map("changed_by_id")
  timestamp   DateTime                @default(now())
  createdAt   DateTime                @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([timestamp])
  @@map("employee_lifecycle_events")
}

model CompanyPolicy {
  id                String       @id @default(cuid())
  /// Groups all versions of the same logical policy document.
  familyId          String       @map("family_id")
  previousVersionId String?      @unique @map("previous_version_id")
  title             String
  description       String?
  version           String       @default("1.0")
  status            PolicyStatus @default(DRAFT)
  fileId            String?      @map("file_id")
  publishedAt       DateTime?    @map("published_at")
  publishedById     String?      @map("published_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")

  file             StoredFile?             @relation(fields: [fileId], references: [id])
  publishedBy      User?                   @relation("PolicyPublisher", fields: [publishedById], references: [id])
  previousVersion  CompanyPolicy?          @relation("PolicyVersionChain", fields: [previousVersionId], references: [id])
  nextVersion      CompanyPolicy?          @relation("PolicyVersionChain")
  acknowledgements PolicyAcknowledgement[]

  @@index([familyId])
  @@index([status])
  @@map("company_policies")
}

model PolicyAssignment {
  id           String                 @id @default(cuid())
  /// Matches CompanyPolicy.familyId — all versions of a policy series.
  familyId     String                 @map("family_id")
  targetType   PolicyAssignmentTarget @map("target_type")
  userId       String?                @map("user_id")
  departmentId String?                @map("department_id")
  teamId       String?                @map("team_id")
  assignedById String?                @map("assigned_by_id")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  deletedAt    DateTime?              @map("deleted_at")

  user       User?       @relation("PolicyAssignmentTargetUser", fields: [userId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  team       Team?       @relation(fields: [teamId], references: [id])
  assignedBy User?       @relation("PolicyAssignmentCreator", fields: [assignedById], references: [id])

  @@index([familyId])
  @@index([userId])
  @@index([departmentId])
  @@index([teamId])
  @@map("policy_assignments")
}

model PolicyAcknowledgement {
  id             String   @id @default(cuid())
  policyId       String   @map("policy_id")
  userId         String   @map("user_id")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  policy CompanyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([policyId, userId])
  @@index([userId])
  @@map("policy_acknowledgements")
}

model Asset {
  id           String      @id @default(cuid())
  name         String
  tag          String      @unique
  category     String?
  serialNumber String?     @map("serial_number")
  status       AssetStatus @default(AVAILABLE)
  employeeId   String?     @map("employee_id")
  assignedAt   DateTime?   @map("assigned_at")
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([status])
  @@index([employeeId])
  @@map("assets")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  title     String
  message   String
  isRead    Boolean   @default(false) @map("is_read")
  link      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model SupportTicket {
  id               String              @id @default(cuid())
  userId           String              @map("user_id")
  assignedToId     String?             @map("assigned_to_id")
  subject          String
  description      String
  status           SupportTicketStatus @default(OPEN)
  priority         String              @default("medium")
  category         String?
  latestReply      String?             @map("latest_reply")
  attachmentFileId String?             @map("attachment_file_id")
  resolvedAt       DateTime?           @map("resolved_at")
  closedAt         DateTime?           @map("closed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  deletedAt        DateTime?           @map("deleted_at")

  user       User                   @relation("TicketRequester", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User?                  @relation("TicketAssignee", fields: [assignedToId], references: [id])
  attachment StoredFile?            @relation(fields: [attachmentFileId], references: [id])
  messages   SupportTicketMessage[]

  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id               String                     @id @default(cuid())
  ticketId         String                     @map("ticket_id")
  authorId         String?                    @map("author_id")
  authorType       SupportTicketMessageAuthor @map("author_type")
  body             String
  attachmentFileId String?                    @map("attachment_file_id")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  deletedAt        DateTime?                  @map("deleted_at")

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User?         @relation(fields: [authorId], references: [id])
  attachment StoredFile?   @relation(fields: [attachmentFileId], references: [id])

  @@index([ticketId])
  @@index([authorId])
  @@map("support_ticket_messages")
}

// ============================================================================
// ATTENDANCE & LEAVE (Phase 3)
// ============================================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
  WEEKEND
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalActionType {
  APPROVE
  REJECT
  REQUEST_CHANGES
  CANCEL
}

model Shift {
  id          String    @id @default(cuid())
  name        String
  code        String?   @unique
  startTime   String    @map("start_time")
  endTime     String    @map("end_time")
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  attendanceRecords AttendanceRecord[]

  @@map("shifts")
}

model Holiday {
  id          String    @id @default(cuid())
  name        String
  date        DateTime  @db.Date
  description String?
  isOptional  Boolean   @default(false) @map("is_optional")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([date])
  @@map("holidays")
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  employeeId   String           @map("employee_id")
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  shiftId      String?          @map("shift_id")
  checkInTime  DateTime?        @map("check_in_time")
  checkOutTime DateTime?        @map("check_out_time")
  workHours    Float?           @map("work_hours")
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  deletedAt    DateTime?        @map("deleted_at")

  shift              Shift?                        @relation(fields: [shiftId], references: [id])
  correctionRequests AttendanceCorrectionRequest[]

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("attendance_records")
}

model AttendanceCorrectionRequest {
  id                 String                     @id @default(cuid())
  attendanceRecordId String?                    @map("attendance_record_id")
  employeeId         String                     @map("employee_id")
  date               DateTime                   @db.Date
  requestedStatus    AttendanceStatus           @map("requested_status")
  requestedCheckIn   DateTime?                  @map("requested_check_in")
  requestedCheckOut  DateTime?                  @map("requested_check_out")
  reason             String
  status             AttendanceCorrectionStatus @default(PENDING)
  approvalRequestId  String?                    @map("approval_request_id")
  reviewedById       String?                    @map("reviewed_by_id")
  reviewedAt         DateTime?                  @map("reviewed_at")
  reviewNotes        String?                    @map("review_notes")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  deletedAt          DateTime?                  @map("deleted_at")

  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id])
  approvalRequest  ApprovalRequest?  @relation(fields: [approvalRequestId], references: [id])

  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("attendance_correction_requests")
}

model LeaveType {
  id                  String    @id @default(cuid())
  name                String    @unique
  code                String?   @unique
  description         String?
  defaultBalance      Int       @default(0) @map("default_balance")
  carryForward        Boolean   @default(false) @map("carry_forward")
  maxCarryForwardDays Int       @default(0) @map("max_carry_forward_days")
  requiresApproval    Boolean   @default(true) @map("requires_approval")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  leaveBalances     LeaveBalance[]
  leaveApplications LeaveApplication[]

  @@map("leave_types")
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String    @map("employee_id")
  leaveTypeId String    @map("leave_type_id")
  year        Int
  allocated   Float     @default(0)
  used        Float     @default(0)
  balance     Float     @default(0)
  carriedOver Float     @default(0) @map("carried_over")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([year])
  @@map("leave_balances")
}

model LeaveApplication {
  id                String                 @id @default(cuid())
  employeeId        String                 @map("employee_id")
  leaveTypeId       String                 @map("leave_type_id")
  startDate         DateTime               @map("start_date") @db.Date
  endDate           DateTime               @map("end_date") @db.Date
  dayCount          Float                  @map("day_count")
  reason            String
  status            LeaveApplicationStatus @default(PENDING)
  approvalRequestId String?                @map("approval_request_id")
  appliedAt         DateTime               @default(now()) @map("applied_at")
  reviewedById      String?                @map("reviewed_by_id")
  reviewedAt        DateTime?              @map("reviewed_at")
  reviewNotes       String?                @map("review_notes")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  deletedAt         DateTime?              @map("deleted_at")

  leaveType       LeaveType        @relation(fields: [leaveTypeId], references: [id])
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("leave_applications")
}

// ============================================================================
// ASSET MANAGEMENT HISTORY (Phase 3)
// ============================================================================

enum AssetHistoryAction {
  ASSIGNED
  RETURNED
  STATUS_CHANGED
  DAMAGED
  LOST
  MAINTENANCE
  RETIRED
}

model AssetHistory {
  id          String             @id @default(cuid())
  assetId     String             @map("asset_id")
  employeeId  String?            @map("employee_id")
  action      AssetHistoryAction
  fromStatus  AssetStatus?       @map("from_status")
  toStatus    AssetStatus?       @map("to_status")
  notes       String?
  performedBy String?            @map("performed_by")
  timestamp   DateTime           @default(now())
  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([assetId])
  @@index([employeeId])
  @@index([timestamp])
  @@map("asset_history")
}

// ============================================================================
// GENERIC APPROVAL WORKFLOW ENGINE (Phase 3)
// ============================================================================

model ApprovalRequest {
  id           String                @id @default(cuid())
  entityType   String                @map("entity_type")
  entityId     String                @map("entity_id")
  requesterId  String                @map("requester_id")
  currentLevel Int                   @default(1) @map("current_level")
  totalLevels  Int                   @default(1) @map("total_levels")
  status       ApprovalRequestStatus @default(PENDING)
  metadata     Json?
  completedAt  DateTime?             @map("completed_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  deletedAt    DateTime?             @map("deleted_at")

  steps                 ApprovalStep[]
  actions               ApprovalAction[]
  leaveApplications     LeaveApplication[]
  attendanceCorrections AttendanceCorrectionRequest[]
  invoices              Invoice[]
  reimbursements        Reimbursement[]
  salaryRevisions       SalaryRevision[]
  payrollRuns           PayrollRun[]

  @@index([entityType, entityId])
  @@index([requesterId])
  @@index([status])
  @@map("approval_requests")
}

model ApprovalStep {
  id                String                @id @default(cuid())
  approvalRequestId String                @map("approval_request_id")
  level             Int
  approverId        String                @map("approver_id")
  status            ApprovalRequestStatus @default(PENDING)
  assignedAt        DateTime              @default(now()) @map("assigned_at")
  respondedAt       DateTime?             @map("responded_at")
  notes             String?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId])
  @@index([approverId])
  @@index([status])
  @@map("approval_steps")
}

model ApprovalAction {
  id                String             @id @default(cuid())
  approvalRequestId String             @map("approval_request_id")
  actorId           String             @map("actor_id")
  actionType        ApprovalActionType @map("action_type")
  level             Int
  notes             String?
  timestamp         DateTime           @default(now())
  createdAt         DateTime           @default(now()) @map("created_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId])
  @@index([actorId])
  @@index([timestamp])
  @@map("approval_actions")
}

// ============================================================================
// FINANCE MODULE (Phase 4)
// ============================================================================

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REJECTED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Client {
  id             String       @id @default(cuid())
  name           String
  companyName    String?      @map("company_name")
  email          String?
  phone          String?
  billingAddress String?      @map("billing_address")
  city           String?
  state          String?
  country        String?
  postalCode     String?      @map("postal_code")
  taxId          String?      @map("tax_id")
  status         ClientStatus @default(ACTIVE)
  notes          String?
  createdById    String?      @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  invoices Invoice[]

  @@index([status])
  @@map("clients")
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique @map("invoice_number")
  clientId          String        @map("client_id")
  issueDate         DateTime      @map("issue_date") @db.Date
  dueDate           DateTime      @map("due_date") @db.Date
  currency          String        @default("USD")
  subtotal          Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount       Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  amountPaid        Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status            InvoiceStatus @default(DRAFT)
  notes             String?
  approvalRequestId String?       @map("approval_request_id")
  createdById       String        @map("created_by_id")
  sentAt            DateTime?     @map("sent_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  client          Client            @relation(fields: [clientId], references: [id])
  approvalRequest ApprovalRequest?  @relation(fields: [approvalRequestId], references: [id])
  lineItems       InvoiceLineItem[]
  payments        Payment[]

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String   @map("invoice_id")
  description String
  quantity    Float    @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id                String          @id @default(cuid())
  invoiceId         String?         @map("invoice_id")
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("USD")
  provider          PaymentProvider @default(MANUAL)
  status            PaymentStatus   @default(PENDING)
  method            String?
  providerPaymentId String?         @map("provider_payment_id")
  providerSessionId String?         @map("provider_session_id")
  recordedById      String?         @map("recorded_by_id")
  paidAt            DateTime?       @map("paid_at")
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
  @@index([providerPaymentId])
  @@map("payments")
}

model Reimbursement {
  id                String              @id @default(cuid())
  employeeId        String              @map("employee_id")
  category          String
  description       String
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("USD")
  expenseDate       DateTime            @map("expense_date") @db.Date
  receiptFileId     String?             @map("receipt_file_id")
  status            ReimbursementStatus @default(PENDING)
  approvalRequestId String?             @map("approval_request_id")
  paidAt            DateTime?           @map("paid_at")
  paymentReference  String?             @map("payment_reference")
  reviewedById      String?             @map("reviewed_by_id")
  reviewedAt        DateTime?           @map("reviewed_at")
  reviewNotes       String?             @map("review_notes")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  deletedAt         DateTime?           @map("deleted_at")

  employee        Employee         @relation(fields: [employeeId], references: [id])
  receiptFile     StoredFile?      @relation(fields: [receiptFileId], references: [id])
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("reimbursements")
}

// ============================================================================
// PAYROLL MODULE (Phase 4)
// ============================================================================

enum SalaryStructureStatus {
  ACTIVE
  SUPERSEDED
}

enum SalaryRevisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollRunStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSED
  PAID
  CANCELLED
}

enum PayslipStatus {
  GENERATED
  PUBLISHED
}

model SalaryStructure {
  id                  String                @id @default(cuid())
  employeeId          String                @map("employee_id")
  effectiveFrom       DateTime              @map("effective_from") @db.Date
  effectiveTo         DateTime?             @map("effective_to") @db.Date
  currency            String                @default("USD")
  basic               Decimal               @default(0) @db.Decimal(12, 2)
  hra                 Decimal               @default(0) @db.Decimal(12, 2)
  conveyanceAllowance Decimal               @default(0) @map("conveyance_allowance") @db.Decimal(12, 2)
  medicalAllowance    Decimal               @default(0) @map("medical_allowance") @db.Decimal(12, 2)
  specialAllowance    Decimal               @default(0) @map("special_allowance") @db.Decimal(12, 2)
  otherAllowances     Decimal               @default(0) @map("other_allowances") @db.Decimal(12, 2)
  grossSalary         Decimal               @default(0) @map("gross_salary") @db.Decimal(12, 2)
  providentFund       Decimal               @default(0) @map("provident_fund") @db.Decimal(12, 2)
  professionalTax     Decimal               @default(0) @map("professional_tax") @db.Decimal(12, 2)
  incomeTax           Decimal               @default(0) @map("income_tax") @db.Decimal(12, 2)
  otherDeductions     Decimal               @default(0) @map("other_deductions") @db.Decimal(12, 2)
  totalDeductions     Decimal               @default(0) @map("total_deductions") @db.Decimal(12, 2)
  netSalary           Decimal               @default(0) @map("net_salary") @db.Decimal(12, 2)
  status              SalaryStructureStatus @default(ACTIVE)
  revisionReason      String?               @map("revision_reason")
  createdById         String                @map("created_by_id")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  deletedAt           DateTime?             @map("deleted_at")

  employee               Employee         @relation(fields: [employeeId], references: [id])
  payrollRunItems        PayrollRunItem[]
  currentForRevisions    SalaryRevision[] @relation("CurrentStructure")
  resultingFromRevisions SalaryRevision[] @relation("ResultingStructure")

  @@index([employeeId])
  @@index([status])
  @@map("salary_structures")
}

model SalaryRevision {
  id                          String               @id @default(cuid())
  employeeId                  String               @map("employee_id")
  currentSalaryStructureId    String?              @map("current_salary_structure_id")
  resultingSalaryStructureId  String?              @map("resulting_salary_structure_id")
  proposedBasic               Decimal              @map("proposed_basic") @db.Decimal(12, 2)
  proposedHra                 Decimal              @default(0) @map("proposed_hra") @db.Decimal(12, 2)
  proposedConveyanceAllowance Decimal              @default(0) @map("proposed_conveyance_allowance") @db.Decimal(12, 2)
  proposedMedicalAllowance    Decimal              @default(0) @map("proposed_medical_allowance") @db.Decimal(12, 2)
  proposedSpecialAllowance    Decimal              @default(0) @map("proposed_special_allowance") @db.Decimal(12, 2)
  proposedOtherAllowances     Decimal              @default(0) @map("proposed_other_allowances") @db.Decimal(12, 2)
  effectiveFrom               DateTime             @map("effective_from") @db.Date
  reason                      String
  status                      SalaryRevisionStatus @default(PENDING)
  approvalRequestId           String?              @map("approval_request_id")
  requestedById               String               @map("requested_by_id")
  reviewedById                String?              @map("reviewed_by_id")
  reviewedAt                  DateTime?            @map("reviewed_at")
  reviewNotes                 String?              @map("review_notes")
  createdAt                   DateTime             @default(now()) @map("created_at")
  updatedAt                   DateTime             @updatedAt @map("updated_at")
  deletedAt                   DateTime?            @map("deleted_at")

  employee                 Employee         @relation(fields: [employeeId], references: [id])
  currentSalaryStructure   SalaryStructure? @relation("CurrentStructure", fields: [currentSalaryStructureId], references: [id])
  resultingSalaryStructure SalaryStructure? @relation("ResultingStructure", fields: [resultingSalaryStructureId], references: [id])
  approvalRequest          ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("salary_revisions")
}

model PayrollRun {
  id                String           @id @default(cuid())
  month             Int
  year              Int
  payPeriodStart    DateTime         @map("pay_period_start") @db.Date
  payPeriodEnd      DateTime         @map("pay_period_end") @db.Date
  status            PayrollRunStatus @default(DRAFT)
  totalGross        Decimal          @default(0) @map("total_gross") @db.Decimal(12, 2)
  totalDeductions   Decimal          @default(0) @map("total_deductions") @db.Decimal(12, 2)
  totalNet          Decimal          @default(0) @map("total_net") @db.Decimal(12, 2)
  employeeCount     Int              @default(0) @map("employee_count")
  approvalRequestId String?          @map("approval_request_id")
  createdById       String           @map("created_by_id")
  processedAt       DateTime?        @map("processed_at")
  paidAt            DateTime?        @map("paid_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")

  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])
  items           PayrollRunItem[]

  @@unique([month, year])
  @@index([status])
  @@map("payroll_runs")
}

model PayrollRunItem {
  id                String   @id @default(cuid())
  payrollRunId      String   @map("payroll_run_id")
  employeeId        String   @map("employee_id")
  salaryStructureId String   @map("salary_structure_id")
  workingDays       Float    @map("working_days")
  paidDays          Float    @map("paid_days")
  lopDays           Float    @default(0) @map("lop_days")
  grossSalary       Decimal  @map("gross_salary") @db.Decimal(12, 2)
  totalDeductions   Decimal  @map("total_deductions") @db.Decimal(12, 2)
  netSalary         Decimal  @map("net_salary") @db.Decimal(12, 2)
  breakdown         Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  payrollRun      PayrollRun      @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee        Employee        @relation(fields: [employeeId], references: [id])
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id])
  payslip         Payslip?

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payroll_run_items")
}

model Payslip {
  id               String        @id @default(cuid())
  payrollRunItemId String        @unique @map("payroll_run_item_id")
  employeeId       String        @map("employee_id")
  month            Int
  year             Int
  fileId           String?       @map("file_id")
  status           PayslipStatus @default(GENERATED)
  generatedAt      DateTime      @default(now()) @map("generated_at")
  publishedAt      DateTime?     @map("published_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  payrollRunItem PayrollRunItem @relation(fields: [payrollRunItemId], references: [id])
  employee       Employee       @relation(fields: [employeeId], references: [id])
  file           StoredFile?    @relation(fields: [fileId], references: [id])

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@map("payslips")
}
