// Workforce 360 ERP — Prisma schema (API-only)
// Migrations live in /db/migrations. Never access this from /apps/web.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SYSTEM & HEALTH
// ============================================================================

model HealthProbe {
  id        String    @id @default(cuid())
  label     String    @default("ok")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("health_probes")
}

// ============================================================================
// ORGANIZATION STRUCTURE
// ============================================================================

model Company {
  id              String    @id @default(cuid())
  name            String
  legalName       String?   @map("legal_name")
  registrationNo  String?   @unique @map("registration_no")
  taxId           String?   @unique @map("tax_id")
  email           String?
  phone           String?
  website         String?
  logo            String?
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?   @map("postal_code")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  departments     Department[]
  offices         Office[]

  @@map("companies")
}

model Department {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  name        String
  code        String?
  description String?
  managerId   String?   @map("manager_id")
  parentId    String?   @map("parent_id")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager     User?        @relation("DepartmentManager", fields: [managerId], references: [id])
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentHierarchy")
  teams         Team[]
  users         User[]
  designations  Designation[]
  jobPostings   JobPosting[]
  policyAssignments PolicyAssignment[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([managerId])
  @@index([parentId])
  @@map("departments")
}

model Team {
  id           String    @id @default(cuid())
  departmentId String    @map("department_id")
  name         String
  code         String?
  description  String?
  leadId       String?   @map("lead_id")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lead         User?        @relation("TeamLead", fields: [leadId], references: [id])
  members      TeamMember[]
  policyAssignments PolicyAssignment[]

  @@unique([departmentId, code])
  @@index([departmentId])
  @@index([leadId])
  @@map("teams")
}

model TeamMember {
  id        String    @id @default(cuid())
  teamId    String    @map("team_id")
  userId    String    @map("user_id")
  role      String?
  joinedAt  DateTime  @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Designation {
  id           String    @id @default(cuid())
  departmentId String    @map("department_id")
  name         String
  code         String?
  level        Int
  /// Approved position capacity for this title (vacant = headcount − assigned users).
  headcount    Int       @default(1)
  description  String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users        User[]
  jobPostings  JobPosting[]

  @@unique([departmentId, code])
  @@index([departmentId])
  @@map("designations")
}

model Office {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  name        String
  code        String?
  type        String?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?   @map("postal_code")
  phone       String?
  email       String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("offices")
}

model EmployeeType {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users       User[]

  @@map("employee_types")
}

model EmploymentStatus {
  id          String    @id @default(cuid())
  /// Workforce status: Active, On Probation, On Leave, Notice Period, Suspended, Terminated
  name        String    @unique
  code        String?   @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users       User[]

  @@map("employment_statuses")
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String?   @map("password_hash")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  phone              String?
  avatar             String?
  /// Account lifecycle: active | inactive | blocked | deleted
  status             String    @default("active")
  employeeId         String?   @unique @map("employee_id")
  dateOfBirth        DateTime? @map("date_of_birth")
  dateOfJoining      DateTime? @map("date_of_joining")
  departmentId       String?   @map("department_id")
  designationId      String?   @map("designation_id")
  officeId           String?   @map("office_id")
  employeeTypeId     String?   @map("employee_type_id")
  employmentStatusId String?   @map("employment_status_id")
  managerId          String?   @map("manager_id")
  emailVerified      Boolean   @default(false) @map("email_verified")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  googleId           String?   @unique @map("google_id")
  lastLoginAt        DateTime? @map("last_login_at")
  /// Bumped to invalidate all JWTs (password change, admin force logout, token reuse).
  sessionVersion     Int       @default(0) @map("session_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  department         Department?       @relation(fields: [departmentId], references: [id])
  designation        Designation?      @relation(fields: [designationId], references: [id])
  office             Office?           @relation(fields: [officeId], references: [id])
  employeeType       EmployeeType?     @relation(fields: [employeeTypeId], references: [id])
  employmentStatus   EmploymentStatus? @relation(fields: [employmentStatusId], references: [id])
  manager            User?             @relation("UserReportsTo", fields: [managerId], references: [id])
  subordinates       User[]            @relation("UserReportsTo")

  managedDepartments Department[]      @relation("DepartmentManager")
  ledTeams           Team[]            @relation("TeamLead")
  teamMemberships    TeamMember[]
  userRoles          UserRole[]
  refreshTokens      RefreshToken[]
  loginHistory       LoginHistory[]
  auditLogs          AuditLog[]
  passwordResets     PasswordReset[]

  candidateProfile   Candidate?
  employeeMaster     Employee?
  conductedInterviews Interview[] @relation("InterviewInterviewer")
  publishedPolicies  CompanyPolicy[] @relation("PolicyPublisher")
  policyAssignments  PolicyAssignment[] @relation("PolicyAssignmentTargetUser")
  policyAssignmentsCreated PolicyAssignment[] @relation("PolicyAssignmentCreator")
  policyAcknowledgements PolicyAcknowledgement[]
  notifications      Notification[]
  notificationPreferences NotificationPreference[]
  publishedAnnouncements Announcement[] @relation("AnnouncementPublisher")
  supportTickets     SupportTicket[] @relation("TicketRequester")
  assignedTickets    SupportTicket[] @relation("TicketAssignee")
  ticketMessages     SupportTicketMessage[]
  kbArticles         KnowledgeBaseArticle[] @relation("KbArticleAuthor")
  uploadedFiles      StoredFile[] @relation("FileUploader")
  assignedLeads      Lead[] @relation("LeadAssignee")
  managedProjects    Project[] @relation("ProjectManager")
  assignedTasks      Task[] @relation("TaskAssignee")
  reportedTasks      Task[] @relation("TaskReporter")
  taskTimeEntries    TaskTimeEntry[] @relation("TaskTimeEntry")
  taskComments       TaskComment[] @relation("TaskComment")
  projectAllocations ProjectTeamAllocation[] @relation("ProjectTeamMember")

  attendanceRecords  AttendanceRecord[] @relation("UserAttendance")
  leaveApplications  LeaveApplication[] @relation("UserLeaveApplications")
  leaveReviews       LeaveApplication[] @relation("LeaveReviewer")
  timesheetEntries   TimesheetEntry[] @relation("UserTimesheets")
  createdInvoices    Invoice[] @relation("InvoiceCreator")
  recordedPayments   Payment[] @relation("PaymentRecorder")
  reimbursements     Reimbursement[] @relation("UserReimbursements")
  reimbursementReviews Reimbursement[] @relation("ReimbursementReviewer")
  salaryStructures   SalaryStructure[]
  payslips           Payslip[]
  createdPayrollRuns PayrollRun[] @relation("PayrollRunCreator")
  approvalRequests   ApprovalRequest[] @relation("ApprovalRequester")
  approvalSteps      ApprovalStep[] @relation("StepApprover")
  approvalStepsDelegatedFrom ApprovalStep[] @relation("StepDelegatedFrom")
  approvalActions    ApprovalAction[] @relation("ApprovalActionActor")
  approvalDelegationsGiven ApprovalDelegation[] @relation("DelegationDelegator")
  approvalDelegationsReceived ApprovalDelegation[] @relation("DelegationDelegate")
  createdDocuments   ManagedDocument[] @relation("DocumentCreator")
  documentVersionsUploaded DocumentVersion[] @relation("DocumentVersionUploader")
  documentPermissions DocumentPermission[] @relation("DocumentPermissionUser")
  mfaEnrollment      UserMfa?
  trustedDevices     TrustedDevice[]
  reportSchedulesCreated ReportSchedule[] @relation("ReportScheduleCreator")
  notificationTemplatesUpdated NotificationTemplate[] @relation("NotificationTemplateUpdater")
  systemSettingsUpdated SystemSetting[] @relation("SystemSettingUpdater")
  securityEvents     SecurityEvent[] @relation("SecurityEventUser")
  deployedReleases   Release[] @relation("ReleaseDeployer")
  assignedTestCases  TestCase[] @relation("TestCaseAssignee")
  createdTestCases   TestCase[] @relation("TestCaseCreator")
  executedTestCases  TestCase[] @relation("TestCaseExecutor")
  createdDocs        Documentation[] @relation("DocumentationCreator")
  createdTrainings   TechTraining[] @relation("TrainingCreator")
  trainingEnrollments TrainingEnrollment[]
  authoredCodeReviews CodeReview[] @relation("CodeReviewAuthor")
  reviewedCodeReviews CodeReview[] @relation("CodeReviewer")

  @@index([email])
  @@index([departmentId])
  @@index([managerId])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  isRevoked   Boolean   @default(false) @map("is_revoked")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model LoginHistory {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  status      String
  method      String
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
  @@map("login_history")
}

model PasswordReset {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  isUsed      Boolean   @default(false) @map("is_used")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

// ============================================================================
// RBAC
// ============================================================================

model Role {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String?   @unique
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  isActive    Boolean   @default(true) @map("is_active")
  /// When true, users with this role must complete MFA before session is fully issued.
  requiresMfa Boolean   @default(false) @map("requires_mfa")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  userRoles        UserRole[]
  rolePermissions  RolePermission[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  /// Top-level category: Administration, Organization, etc.
  module      String    @default("General")
  /// Human-readable feature label within the module
  feature     String?
  resource    String
  action      String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  rolePermissions RolePermission[]

  @@index([resource])
  @@index([action])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String    @id @default(cuid())
  roleId       String    @map("role_id")
  permissionId String    @map("permission_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  roleId      String    @map("role_id")
  assignedBy  String?   @map("assigned_by")
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ============================================================================
// RECRUITMENT & HR (Phase 2)
// ============================================================================

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum CandidatePipelineStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferLetterStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum EmployeeLifecycleState {
  PRE_ONBOARDING
  ONBOARDING
  ACTIVE
  OFFBOARDING
  TERMINATED
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PolicyAssignmentTarget {
  ALL
  USER
  DEPARTMENT
  TEAM
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_EMPLOYEE
  RESOLVED
  CLOSED
}

enum SupportTicketMessageAuthor {
  EMPLOYEE
  STAFF
  SYSTEM
}

enum StoredFilePurpose {
  RESUME
  POLICY
  OFFER_LETTER
  DOCUMENT
  PAYSLIP
  REIMBURSEMENT_RECEIPT
  OTHER
}

model StoredFile {
  id           String            @id @default(cuid())
  storageKey   String            @unique @map("storage_key")
  originalName String            @map("original_name")
  mimeType     String            @map("mime_type")
  sizeBytes    Int               @map("size_bytes")
  purpose      StoredFilePurpose @default(OTHER)
  uploadedById String?           @map("uploaded_by_id")
  entityType   String?           @map("entity_type")
  entityId     String?           @map("entity_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  uploadedBy   User?             @relation("FileUploader", fields: [uploadedById], references: [id])
  candidateResumes Candidate[]   @relation("CandidateResume")
  offerLetters OfferLetter[]
  policies     CompanyPolicy[]
  supportTickets SupportTicket[]
  ticketMessages SupportTicketMessage[]
  payslips     Payslip[] @relation("PayslipPDF")
  reimbursements Reimbursement[] @relation("ReimbursementReceipt")
  documentVersions DocumentVersion[]

  @@index([uploadedById])
  @@index([entityType, entityId])
  @@map("stored_files")
}

model JobPosting {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  description     String
  requirements    String?
  departmentId    String?           @map("department_id")
  designationId   String?           @map("designation_id")
  location        String?
  employmentType  String?           @map("employment_type")
  status          JobPostingStatus  @default(DRAFT)
  publishedAt     DateTime?         @map("published_at")
  closedAt        DateTime?         @map("closed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  department      Department?       @relation(fields: [departmentId], references: [id])
  designation     Designation?      @relation(fields: [designationId], references: [id])
  applications    JobApplication[]

  @@index([status])
  @@index([departmentId])
  @@map("job_postings")
}

model Candidate {
  id            String                  @id @default(cuid())
  userId        String?                 @unique @map("user_id")
  email         String                  @unique
  firstName     String                  @map("first_name")
  lastName      String                  @map("last_name")
  phone         String?
  linkedInUrl   String?                 @map("linkedin_url")
  resumeFileId  String?                 @map("resume_file_id")
  pipelineStatus CandidatePipelineStatus @default(APPLIED) @map("pipeline_status")
  notes         String?
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  deletedAt     DateTime?               @map("deleted_at")

  user          User?                   @relation(fields: [userId], references: [id])
  resumeFile    StoredFile?             @relation("CandidateResume", fields: [resumeFileId], references: [id])
  applications  JobApplication[]
  employee      Employee?

  @@index([pipelineStatus])
  @@map("candidates")
}

model JobApplication {
  id            String                  @id @default(cuid())
  candidateId   String                  @map("candidate_id")
  jobPostingId  String                  @map("job_posting_id")
  status        CandidatePipelineStatus @default(APPLIED)
  coverLetter   String?                 @map("cover_letter")
  appliedAt     DateTime                @default(now()) @map("applied_at")
  statusNotes   String?                 @map("status_notes")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  deletedAt     DateTime?               @map("deleted_at")

  candidate     Candidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosting    JobPosting              @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  interviews    Interview[]
  assessments   Assessment[]
  offerLetters  OfferLetter[]
  checklistItems PreOnboardingChecklistItem[]

  @@unique([candidateId, jobPostingId])
  @@index([status])
  @@index([candidateId])
  @@index([jobPostingId])
  @@map("job_applications")
}

model Interview {
  id              String          @id @default(cuid())
  applicationId   String          @map("application_id")
  scheduledAt     DateTime        @map("scheduled_at")
  durationMinutes Int             @default(60) @map("duration_minutes")
  location        String?
  meetingLink     String?         @map("meeting_link")
  interviewerId   String?         @map("interviewer_id")
  status          InterviewStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  application     JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer     User?           @relation("InterviewInterviewer", fields: [interviewerId], references: [id])

  @@index([applicationId])
  @@index([interviewerId])
  @@index([scheduledAt])
  @@map("interviews")
}

model Assessment {
  id            String         @id @default(cuid())
  applicationId String         @map("application_id")
  title         String
  description   String?
  dueAt         DateTime?      @map("due_at")
  completedAt   DateTime?      @map("completed_at")
  score         Float?
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("assessments")
}

model OfferLetter {
  id            String            @id @default(cuid())
  applicationId String            @map("application_id")
  salary        Decimal?          @db.Decimal(12, 2)
  currency      String            @default("USD")
  startDate     DateTime?         @map("start_date")
  content       String
  status        OfferLetterStatus @default(DRAFT)
  fileId        String?           @map("file_id")
  sentAt        DateTime?         @map("sent_at")
  acceptedAt    DateTime?         @map("accepted_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  application   JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  file          StoredFile?       @relation(fields: [fileId], references: [id])

  @@index([applicationId])
  @@index([status])
  @@map("offer_letters")
}

model PreOnboardingChecklistItem {
  id            String         @id @default(cuid())
  applicationId String         @map("application_id")
  title         String
  isRequired    Boolean        @default(true) @map("is_required")
  isCompleted   Boolean        @default(false) @map("is_completed")
  completedAt   DateTime?      @map("completed_at")
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("pre_onboarding_checklist_items")
}

/// Atomic counter for EMP### employee ID generation (single row, id = "default").
model EmployeeIdSequence {
  id        String   @id @default("default")
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employee_id_sequences")
}

model Employee {
  id                    String                 @id @default(cuid())
  userId                String                 @unique @map("user_id")
  candidateId           String?                @unique @map("candidate_id")
  employeeCode          String                 @unique @map("employee_code")
  lifecycleState        EmployeeLifecycleState @default(PRE_ONBOARDING) @map("lifecycle_state")
  hiredAt               DateTime               @default(now()) @map("hired_at")
  terminatedAt          DateTime?              @map("terminated_at")
  emergencyContactName  String?                @map("emergency_contact_name")
  emergencyContactPhone String?                @map("emergency_contact_phone")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")

  user                  User                   @relation(fields: [userId], references: [id])
  candidate             Candidate?             @relation(fields: [candidateId], references: [id])
  lifecycleEvents       EmployeeLifecycleEvent[]
  assignedAssets        Asset[]

  @@index([lifecycleState])
  @@map("employees")
}

model EmployeeLifecycleEvent {
  id          String                  @id @default(cuid())
  employeeId  String                  @map("employee_id")
  fromState   EmployeeLifecycleState? @map("from_state")
  toState     EmployeeLifecycleState  @map("to_state")
  notes       String?
  changedById String?                 @map("changed_by_id")
  timestamp   DateTime                @default(now())
  createdAt   DateTime                @default(now()) @map("created_at")

  employee    Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([timestamp])
  @@map("employee_lifecycle_events")
}

model CompanyPolicy {
  id                String       @id @default(cuid())
  /// Groups all versions of the same logical policy document.
  familyId          String       @map("family_id")
  previousVersionId String?      @unique @map("previous_version_id")
  title             String
  description       String?
  version           String       @default("1.0")
  status            PolicyStatus @default(DRAFT)
  fileId            String?      @map("file_id")
  publishedAt       DateTime?    @map("published_at")
  publishedById     String?      @map("published_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")

  file              StoredFile?  @relation(fields: [fileId], references: [id])
  publishedBy       User?        @relation("PolicyPublisher", fields: [publishedById], references: [id])
  previousVersion   CompanyPolicy? @relation("PolicyVersionChain", fields: [previousVersionId], references: [id])
  nextVersion       CompanyPolicy? @relation("PolicyVersionChain")
  acknowledgements  PolicyAcknowledgement[]

  @@index([familyId])
  @@index([status])
  @@map("company_policies")
}

model PolicyAssignment {
  id           String                 @id @default(cuid())
  /// Matches CompanyPolicy.familyId — all versions of a policy series.
  familyId     String                 @map("family_id")
  targetType   PolicyAssignmentTarget @map("target_type")
  userId       String?                @map("user_id")
  departmentId String?                @map("department_id")
  teamId       String?                @map("team_id")
  assignedById String?                @map("assigned_by_id")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  deletedAt    DateTime?              @map("deleted_at")

  user         User?         @relation("PolicyAssignmentTargetUser", fields: [userId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  team         Team?         @relation(fields: [teamId], references: [id])
  assignedBy   User?         @relation("PolicyAssignmentCreator", fields: [assignedById], references: [id])

  @@index([familyId])
  @@index([userId])
  @@index([departmentId])
  @@index([teamId])
  @@map("policy_assignments")
}

model PolicyAcknowledgement {
  id              String   @id @default(cuid())
  policyId        String   @map("policy_id")
  userId          String   @map("user_id")
  acknowledgedAt  DateTime @default(now()) @map("acknowledged_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  policy          CompanyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([policyId, userId])
  @@index([userId])
  @@map("policy_acknowledgements")
}

model Asset {
  id           String      @id @default(cuid())
  name         String
  tag          String      @unique
  category     String?
  serialNumber String?     @map("serial_number")
  status       AssetStatus @default(AVAILABLE)
  employeeId   String?     @map("employee_id")
  assignedAt   DateTime?   @map("assigned_at")
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  employee     Employee?   @relation(fields: [employeeId], references: [id])

  @@index([status])
  @@index([employeeId])
  @@map("assets")
}

enum NotificationCategory {
  TICKET
  APPROVAL
  LEAVE
  PAYROLL
  FINANCE
  HR
  ANNOUNCEMENT
  SYSTEM
  DOCUMENT
}

model Notification {
  id          String                @id @default(cuid())
  userId      String                @map("user_id")
  title       String
  message     String
  category    NotificationCategory  @default(SYSTEM)
  isRead      Boolean               @default(false) @map("is_read")
  link        String?
  emailSentAt DateTime?             @map("email_sent_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  deletedAt   DateTime?             @map("deleted_at")

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([category])
  @@map("notifications")
}

model NotificationPreference {
  id            String               @id @default(cuid())
  userId        String               @map("user_id")
  category      NotificationCategory
  inAppEnabled  Boolean              @default(true) @map("in_app_enabled")
  emailEnabled  Boolean              @default(true) @map("email_enabled")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  deletedAt     DateTime?            @map("deleted_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("notification_preferences")
}

model Announcement {
  id            String    @id @default(cuid())
  title         String
  body          String
  publishedById String    @map("published_by_id")
  publishedAt   DateTime? @map("published_at")
  expiresAt     DateTime? @map("expires_at")
  isActive      Boolean   @default(true) @map("is_active")
  audience      String    @default("ALL") // ALL | ROLE:<code> | DEPT:<id>
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  publishedBy   User      @relation("AnnouncementPublisher", fields: [publishedById], references: [id])

  @@index([isActive])
  @@index([publishedAt])
  @@map("announcements")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SlaPolicy {
  id                   String         @id @default(cuid())
  name                 String
  priority             TicketPriority @unique
  firstResponseMinutes Int            @map("first_response_minutes")
  resolutionMinutes    Int            @map("resolution_minutes")
  escalateAfterMinutes Int?           @map("escalate_after_minutes")
  isActive             Boolean        @default(true) @map("is_active")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedAt            DateTime?      @map("deleted_at")

  tickets              SupportTicket[]

  @@map("sla_policies")
}

model SupportTicket {
  id                  String              @id @default(cuid())
  ticketNumber        String?             @unique @map("ticket_number")
  userId              String              @map("user_id")
  assignedToId        String?             @map("assigned_to_id")
  subject             String
  description         String
  status              SupportTicketStatus @default(OPEN)
  priority            TicketPriority      @default(MEDIUM)
  category            String?
  latestReply         String?             @map("latest_reply")
  attachmentFileId    String?             @map("attachment_file_id")
  slaPolicyId         String?             @map("sla_policy_id")
  firstResponseDueAt  DateTime?           @map("first_response_due_at")
  resolutionDueAt     DateTime?           @map("resolution_due_at")
  firstRespondedAt    DateTime?           @map("first_responded_at")
  escalatedAt         DateTime?           @map("escalated_at")
  escalationLevel     Int                 @default(0) @map("escalation_level")
  approvalRequestId   String?             @unique @map("approval_request_id")
  resolvedAt          DateTime?           @map("resolved_at")
  closedAt            DateTime?           @map("closed_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("deleted_at")

  user                User                @relation("TicketRequester", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo          User?               @relation("TicketAssignee", fields: [assignedToId], references: [id])
  attachment          StoredFile?         @relation(fields: [attachmentFileId], references: [id])
  slaPolicy           SlaPolicy?          @relation(fields: [slaPolicyId], references: [id])
  approvalRequest     ApprovalRequest?    @relation(fields: [approvalRequestId], references: [id])
  messages            SupportTicketMessage[]

  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([resolutionDueAt])
  @@map("support_tickets")
}

model KnowledgeBaseArticle {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  category    String?
  tags        String[]  @default([])
  isPublished Boolean   @default(false) @map("is_published")
  viewCount   Int       @default(0) @map("view_count")
  authorId    String    @map("author_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  author      User      @relation("KbArticleAuthor", fields: [authorId], references: [id])

  @@index([isPublished])
  @@index([category])
  @@map("knowledge_base_articles")
}

model SupportTicketMessage {
  id               String                      @id @default(cuid())
  ticketId         String                      @map("ticket_id")
  authorId         String?                     @map("author_id")
  authorType       SupportTicketMessageAuthor  @map("author_type")
  body             String
  attachmentFileId String?                     @map("attachment_file_id")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  deletedAt        DateTime?                   @map("deleted_at")

  ticket           SupportTicket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author           User?                       @relation(fields: [authorId], references: [id])
  attachment       StoredFile?                 @relation(fields: [attachmentFileId], references: [id])

  @@index([ticketId])
  @@index([authorId])
  @@map("support_ticket_messages")
}

// ============================================================================
// BUSINESS DEVELOPMENT (Phase 5)
// ============================================================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum BidStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ProposalStatus {
  DRAFT
  SENT
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  REVISED
}

model Contact {
  id             String    @id @default(cuid())
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String?
  phone          String?
  company        String?
  designation    String?
  linkedInUrl    String?   @map("linkedin_url")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  leads          Lead[]
  communications ClientCommunication[]
  projects       Project[]

  @@index([email])
  @@index([company])
  @@map("contacts")
}

model Lead {
  id             String     @id @default(cuid())
  title          String
  description    String?
  status         LeadStatus @default(NEW)
  value          Decimal?   @db.Decimal(12, 2)
  currency       String     @default("USD")
  source         String?
  contactId      String?    @map("contact_id")
  companyName    String?    @map("company_name")
  assignedToId   String?    @map("assigned_to_id")
  expectedCloseDate DateTime? @map("expected_close_date")
  wonAt          DateTime?  @map("won_at")
  lostAt         DateTime?  @map("lost_at")
  lostReason     String?    @map("lost_reason")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  contact        Contact?   @relation(fields: [contactId], references: [id])
  assignedTo     User?      @relation("LeadAssignee", fields: [assignedToId], references: [id])
  bids           Bid[]
  proposals      Proposal[]
  communications ClientCommunication[]
  project        Project?

  @@index([status])
  @@index([assignedToId])
  @@index([contactId])
  @@map("leads")
}

model Bid {
  id             String    @id @default(cuid())
  leadId         String    @map("lead_id")
  title          String
  description    String?
  amount         Decimal?  @db.Decimal(12, 2)
  currency       String    @default("USD")
  status         BidStatus @default(DRAFT)
  submittedAt    DateTime? @map("submitted_at")
  deadline       DateTime?
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  proposals      Proposal[]

  @@index([leadId])
  @@index([status])
  @@map("bids")
}

model Proposal {
  id             String         @id @default(cuid())
  leadId         String         @map("lead_id")
  bidId          String?        @map("bid_id")
  title          String
  description    String?
  content        String?
  amount         Decimal?       @db.Decimal(12, 2)
  currency       String         @default("USD")
  status         ProposalStatus @default(DRAFT)
  sentAt         DateTime?      @map("sent_at")
  validUntil     DateTime?      @map("valid_until")
  acceptedAt     DateTime?      @map("accepted_at")
  rejectedAt     DateTime?      @map("rejected_at")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  bid            Bid?           @relation(fields: [bidId], references: [id])

  @@index([leadId])
  @@index([bidId])
  @@index([status])
  @@map("proposals")
}

model ClientCommunication {
  id             String    @id @default(cuid())
  leadId         String?   @map("lead_id")
  contactId      String?   @map("contact_id")
  subject        String
  body           String
  channel        String    @default("email")
  direction      String    @default("outbound")
  timestamp      DateTime  @default(now())
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact        Contact?  @relation(fields: [contactId], references: [id])

  @@index([leadId])
  @@index([contactId])
  @@index([timestamp])
  @@map("client_communications")
}

model PortfolioItem {
  id             String    @id @default(cuid())
  title          String
  description    String?
  category       String?
  clientName     String?   @map("client_name")
  completedAt    DateTime? @map("completed_at")
  technologies   String?
  imageUrl       String?   @map("image_url")
  projectUrl     String?   @map("project_url")
  isPublished    Boolean   @default(false) @map("is_published")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@index([isPublished])
  @@map("portfolio_items")
}

// ============================================================================
// PROJECT MANAGEMENT (Phase 6)
// ============================================================================

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

model Project {
  id                String        @id @default(cuid())
  leadId            String?       @unique @map("lead_id")
  name              String
  code              String?       @unique
  description       String?
  status            ProjectStatus @default(PLANNING)
  budget            Decimal?      @db.Decimal(12, 2)
  currency          String        @default("USD")
  startDate         DateTime?     @map("start_date")
  endDate           DateTime?     @map("end_date")
  managerId         String?       @map("manager_id")
  clientName        String?       @map("client_name")
  clientContactId   String?       @map("client_contact_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  lead              Lead?         @relation(fields: [leadId], references: [id])
  manager           User?         @relation("ProjectManager", fields: [managerId], references: [id])
  clientContact     Contact?      @relation(fields: [clientContactId], references: [id])
  milestones        Milestone[]
  tasks             Task[]
  sprints           Sprint[]
  teamAllocations   ProjectTeamAllocation[]
  budgetTracking    ProjectBudgetTracking[]
  timesheetEntries  TimesheetEntry[]
  releases          Release[]
  testCases         TestCase[]
  documentations    Documentation[]
  codeReviews       CodeReview[]

  @@index([status])
  @@index([managerId])
  @@index([leadId])
  @@map("projects")
}

model Milestone {
  id             String    @id @default(cuid())
  projectId      String    @map("project_id")
  title          String
  description    String?
  dueDate        DateTime? @map("due_date")
  completedAt    DateTime? @map("completed_at")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@index([projectId])
  @@index([dueDate])
  @@map("milestones")
}

model Task {
  id             String       @id @default(cuid())
  projectId      String       @map("project_id")
  milestoneId    String?      @map("milestone_id")
  sprintId       String?      @map("sprint_id")
  releaseId      String?      @map("release_id")
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assigneeId     String?      @map("assignee_id")
  reporterId     String?      @map("reporter_id")
  estimatedHours Decimal?     @db.Decimal(8, 2) @map("estimated_hours")
  actualHours    Decimal?     @db.Decimal(8, 2) @map("actual_hours")
  dueDate        DateTime?    @map("due_date")
  completedAt    DateTime?    @map("completed_at")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      Milestone?   @relation(fields: [milestoneId], references: [id])
  sprint         Sprint?      @relation(fields: [sprintId], references: [id])
  release        Release?     @relation("ReleaseTask", fields: [releaseId], references: [id])
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reporter       User?        @relation("TaskReporter", fields: [reporterId], references: [id])
  timeEntries    TaskTimeEntry[]
  comments       TaskComment[]
  timesheetEntries TimesheetEntry[]
  codeReviews    CodeReview[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([sprintId])
  @@index([releaseId])
  @@index([assigneeId])
  @@index([status])
  @@map("tasks")
}

model Sprint {
  id             String        @id @default(cuid())
  projectId      String        @map("project_id")
  name           String
  goal           String?
  status         SprintStatus  @default(PLANNING)
  startDate      DateTime?     @map("start_date")
  endDate        DateTime?     @map("end_date")
  completedAt    DateTime?     @map("completed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@index([projectId])
  @@index([status])
  @@map("sprints")
}

model TaskTimeEntry {
  id             String    @id @default(cuid())
  taskId         String    @map("task_id")
  userId         String    @map("user_id")
  hours          Decimal   @db.Decimal(8, 2)
  date           DateTime  @db.Date
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User      @relation("TaskTimeEntry", fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@index([date])
  @@map("task_time_entries")
}

model TaskComment {
  id             String    @id @default(cuid())
  taskId         String    @map("task_id")
  userId         String    @map("user_id")
  content        String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User      @relation("TaskComment", fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@map("task_comments")
}

model ProjectTeamAllocation {
  id             String    @id @default(cuid())
  projectId      String    @map("project_id")
  userId         String    @map("user_id")
  role           String?
  allocatedHours Decimal?  @db.Decimal(8, 2) @map("allocated_hours")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  leftAt         DateTime? @map("left_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User      @relation("ProjectTeamMember", fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_team_allocations")
}

model ProjectBudgetTracking {
