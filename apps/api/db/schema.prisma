// Workforce 360 ERP — Prisma schema (API-only)
// Migrations live in /db/migrations. Never access this from /apps/web.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SYSTEM & HEALTH
// ============================================================================

model HealthProbe {
  id        String    @id @default(cuid())
  label     String    @default("ok")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("health_probes")
}

// ============================================================================
// ORGANIZATION STRUCTURE
// ============================================================================

model Company {
  id              String    @id @default(cuid())
  name            String
  legalName       String?   @map("legal_name")
  registrationNo  String?   @unique @map("registration_no")
  taxId           String?   @unique @map("tax_id")
  email           String?
  phone           String?
  website         String?
  logo            String?
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?   @map("postal_code")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  departments     Department[]
  offices         Office[]

  @@map("companies")
}

model Department {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  name        String
  code        String?
  description String?
  managerId   String?   @map("manager_id")
  parentId    String?   @map("parent_id")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager     User?        @relation("DepartmentManager", fields: [managerId], references: [id])
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentHierarchy")
  teams         Team[]
  users         User[]
  designations  Designation[]
  jobPostings   JobPosting[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([managerId])
  @@index([parentId])
  @@map("departments")
}

model Team {
  id           String    @id @default(cuid())
  departmentId String    @map("department_id")
  name         String
  code         String?
  description  String?
  leadId       String?   @map("lead_id")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lead         User?        @relation("TeamLead", fields: [leadId], references: [id])
  members      TeamMember[]

  @@unique([departmentId, code])
  @@index([departmentId])
  @@index([leadId])
  @@map("teams")
}

model TeamMember {
  id        String    @id @default(cuid())
  teamId    String    @map("team_id")
  userId    String    @map("user_id")
  role      String?
  joinedAt  DateTime  @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Designation {
  id           String    @id @default(cuid())
  departmentId String    @map("department_id")
  name         String
  code         String?   @unique
  level        Int
  /// Approved position capacity for this title (vacant = headcount − assigned users).
  headcount    Int       @default(1)
  description  String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users        User[]
  jobPostings  JobPosting[]

  @@index([departmentId])
  @@map("designations")
}

model Office {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  name        String
  code        String?
  type        String?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?   @map("postal_code")
  phone       String?
  email       String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("offices")
}

model EmployeeType {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users       User[]

  @@map("employee_types")
}

model EmploymentStatus {
  id          String    @id @default(cuid())
  /// Employment type label: Full Time, Part Time, Contract, Intern, Probation, Consultant
  name        String    @unique
  code        String?   @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users       User[]

  @@map("employment_statuses")
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String?   @map("password_hash")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  phone              String?
  avatar             String?
  /// Account lifecycle: active | inactive | blocked | deleted
  status             String    @default("active")
  employeeId         String?   @unique @map("employee_id")
  dateOfBirth        DateTime? @map("date_of_birth")
  dateOfJoining      DateTime? @map("date_of_joining")
  departmentId       String?   @map("department_id")
  designationId      String?   @map("designation_id")
  officeId           String?   @map("office_id")
  employeeTypeId     String?   @map("employee_type_id")
  employmentStatusId String?   @map("employment_status_id")
  managerId          String?   @map("manager_id")
  emailVerified      Boolean   @default(false) @map("email_verified")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  googleId           String?   @unique @map("google_id")
  lastLoginAt        DateTime? @map("last_login_at")
  /// Bumped to invalidate all JWTs (password change, admin force logout, token reuse).
  sessionVersion     Int       @default(0) @map("session_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  department         Department?       @relation(fields: [departmentId], references: [id])
  designation        Designation?      @relation(fields: [designationId], references: [id])
  office             Office?           @relation(fields: [officeId], references: [id])
  employeeType       EmployeeType?     @relation(fields: [employeeTypeId], references: [id])
  employmentStatus   EmploymentStatus? @relation(fields: [employmentStatusId], references: [id])
  manager            User?             @relation("UserReportsTo", fields: [managerId], references: [id])
  subordinates       User[]            @relation("UserReportsTo")

  managedDepartments Department[]      @relation("DepartmentManager")
  ledTeams           Team[]            @relation("TeamLead")
  teamMemberships    TeamMember[]
  userRoles          UserRole[]
  refreshTokens      RefreshToken[]
  loginHistory       LoginHistory[]
  auditLogs          AuditLog[]
  passwordResets     PasswordReset[]

  candidateProfile   Candidate?
  employeeMaster     Employee?
  conductedInterviews Interview[] @relation("InterviewInterviewer")
  publishedPolicies  CompanyPolicy[] @relation("PolicyPublisher")
  notifications      Notification[]
  supportTickets     SupportTicket[]
  uploadedFiles      StoredFile[] @relation("FileUploader")

  @@index([email])
  @@index([departmentId])
  @@index([managerId])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  isRevoked   Boolean   @default(false) @map("is_revoked")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model LoginHistory {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  status      String
  method      String
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
  @@map("login_history")
}

model PasswordReset {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  isUsed      Boolean   @default(false) @map("is_used")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

// ============================================================================
// RBAC
// ============================================================================

model Role {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String?   @unique
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  userRoles        UserRole[]
  rolePermissions  RolePermission[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  /// Top-level category: Administration, Organization, etc.
  module      String    @default("General")
  /// Human-readable feature label within the module
  feature     String?
  resource    String
  action      String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  rolePermissions RolePermission[]

  @@index([resource])
  @@index([action])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String    @id @default(cuid())
  roleId       String    @map("role_id")
  permissionId String    @map("permission_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  roleId      String    @map("role_id")
  assignedBy  String?   @map("assigned_by")
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ============================================================================
// RECRUITMENT & HR (Phase 2)
// ============================================================================

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum CandidatePipelineStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferLetterStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum EmployeeLifecycleState {
  PRE_ONBOARDING
  ONBOARDING
  ACTIVE
  OFFBOARDING
  TERMINATED
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum StoredFilePurpose {
  RESUME
  POLICY
  OFFER_LETTER
  DOCUMENT
  OTHER
}

model StoredFile {
  id           String            @id @default(cuid())
  storageKey   String            @unique @map("storage_key")
  originalName String            @map("original_name")
  mimeType     String            @map("mime_type")
  sizeBytes    Int               @map("size_bytes")
  purpose      StoredFilePurpose @default(OTHER)
  uploadedById String?           @map("uploaded_by_id")
  entityType   String?           @map("entity_type")
  entityId     String?           @map("entity_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  uploadedBy   User?             @relation("FileUploader", fields: [uploadedById], references: [id])
  candidateResumes Candidate[]   @relation("CandidateResume")
  offerLetters OfferLetter[]
  policies     CompanyPolicy[]

  @@index([uploadedById])
  @@index([entityType, entityId])
  @@map("stored_files")
}

model JobPosting {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  description     String
  requirements    String?
  departmentId    String?           @map("department_id")
  designationId   String?           @map("designation_id")
  location        String?
  employmentType  String?           @map("employment_type")
  status          JobPostingStatus  @default(DRAFT)
  publishedAt     DateTime?         @map("published_at")
  closedAt        DateTime?         @map("closed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  department      Department?       @relation(fields: [departmentId], references: [id])
  designation     Designation?      @relation(fields: [designationId], references: [id])
  applications    JobApplication[]

  @@index([status])
  @@index([departmentId])
  @@map("job_postings")
}

model Candidate {
  id            String                  @id @default(cuid())
  userId        String?                 @unique @map("user_id")
  email         String                  @unique
  firstName     String                  @map("first_name")
  lastName      String                  @map("last_name")
  phone         String?
  linkedInUrl   String?                 @map("linkedin_url")
  resumeFileId  String?                 @map("resume_file_id")
  pipelineStatus CandidatePipelineStatus @default(APPLIED) @map("pipeline_status")
  notes         String?
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  deletedAt     DateTime?               @map("deleted_at")

  user          User?                   @relation(fields: [userId], references: [id])
  resumeFile    StoredFile?             @relation("CandidateResume", fields: [resumeFileId], references: [id])
  applications  JobApplication[]
  employee      Employee?

  @@index([pipelineStatus])
  @@map("candidates")
}

model JobApplication {
  id            String                  @id @default(cuid())
  candidateId   String                  @map("candidate_id")
  jobPostingId  String                  @map("job_posting_id")
  status        CandidatePipelineStatus @default(APPLIED)
  coverLetter   String?                 @map("cover_letter")
  appliedAt     DateTime                @default(now()) @map("applied_at")
  statusNotes   String?                 @map("status_notes")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  deletedAt     DateTime?               @map("deleted_at")

  candidate     Candidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosting    JobPosting              @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  interviews    Interview[]
  assessments   Assessment[]
  offerLetters  OfferLetter[]
  checklistItems PreOnboardingChecklistItem[]

  @@unique([candidateId, jobPostingId])
  @@index([status])
  @@index([candidateId])
  @@index([jobPostingId])
  @@map("job_applications")
}

model Interview {
  id              String          @id @default(cuid())
  applicationId   String          @map("application_id")
  scheduledAt     DateTime        @map("scheduled_at")
  durationMinutes Int             @default(60) @map("duration_minutes")
  location        String?
  meetingLink     String?         @map("meeting_link")
  interviewerId   String?         @map("interviewer_id")
  status          InterviewStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  application     JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer     User?           @relation("InterviewInterviewer", fields: [interviewerId], references: [id])

  @@index([applicationId])
  @@index([interviewerId])
  @@index([scheduledAt])
  @@map("interviews")
}

model Assessment {
  id            String         @id @default(cuid())
  applicationId String         @map("application_id")
  title         String
  description   String?
  dueAt         DateTime?      @map("due_at")
  completedAt   DateTime?      @map("completed_at")
  score         Float?
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("assessments")
}

model OfferLetter {
  id            String            @id @default(cuid())
  applicationId String            @map("application_id")
  salary        Decimal?          @db.Decimal(12, 2)
  currency      String            @default("USD")
  startDate     DateTime?         @map("start_date")
  content       String
  status        OfferLetterStatus @default(DRAFT)
  fileId        String?           @map("file_id")
  sentAt        DateTime?         @map("sent_at")
  acceptedAt    DateTime?         @map("accepted_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  application   JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  file          StoredFile?       @relation(fields: [fileId], references: [id])

  @@index([applicationId])
  @@index([status])
  @@map("offer_letters")
}

model PreOnboardingChecklistItem {
  id            String         @id @default(cuid())
  applicationId String         @map("application_id")
  title         String
  isRequired    Boolean        @default(true) @map("is_required")
  isCompleted   Boolean        @default(false) @map("is_completed")
  completedAt   DateTime?      @map("completed_at")
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("pre_onboarding_checklist_items")
}

model Employee {
  id                    String                 @id @default(cuid())
  userId                String                 @unique @map("user_id")
  candidateId           String?                @unique @map("candidate_id")
  employeeCode          String                 @unique @map("employee_code")
  lifecycleState        EmployeeLifecycleState @default(PRE_ONBOARDING) @map("lifecycle_state")
  hiredAt               DateTime               @default(now()) @map("hired_at")
  terminatedAt          DateTime?              @map("terminated_at")
  emergencyContactName  String?                @map("emergency_contact_name")
  emergencyContactPhone String?                @map("emergency_contact_phone")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")

  user                  User                   @relation(fields: [userId], references: [id])
  candidate             Candidate?             @relation(fields: [candidateId], references: [id])
  lifecycleEvents       EmployeeLifecycleEvent[]
  assignedAssets        Asset[]

  @@index([lifecycleState])
  @@map("employees")
}

model EmployeeLifecycleEvent {
  id          String                  @id @default(cuid())
  employeeId  String                  @map("employee_id")
  fromState   EmployeeLifecycleState? @map("from_state")
  toState     EmployeeLifecycleState  @map("to_state")
  notes       String?
  changedById String?                 @map("changed_by_id")
  timestamp   DateTime                @default(now())
  createdAt   DateTime                @default(now()) @map("created_at")

  employee    Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([timestamp])
  @@map("employee_lifecycle_events")
}

model CompanyPolicy {
  id            String       @id @default(cuid())
  title         String
  description   String?
  version       String       @default("1.0")
  status        PolicyStatus @default(DRAFT)
  fileId        String?      @map("file_id")
  publishedAt   DateTime?    @map("published_at")
  publishedById String?      @map("published_by_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  file          StoredFile?  @relation(fields: [fileId], references: [id])
  publishedBy   User?        @relation("PolicyPublisher", fields: [publishedById], references: [id])

  @@index([status])
  @@map("company_policies")
}

model Asset {
  id           String      @id @default(cuid())
  name         String
  tag          String      @unique
  category     String?
  serialNumber String?     @map("serial_number")
  status       AssetStatus @default(AVAILABLE)
  employeeId   String?     @map("employee_id")
  assignedAt   DateTime?   @map("assigned_at")
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  employee     Employee?   @relation(fields: [employeeId], references: [id])

  @@index([status])
  @@index([employeeId])
  @@map("assets")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  title     String
  message   String
  isRead    Boolean   @default(false) @map("is_read")
  link      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model SupportTicket {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  subject     String
  description String
  status      SupportTicketStatus @default(OPEN)
  priority    String              @default("medium")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}
