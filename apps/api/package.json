{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Workforce 360 ERP API — Express + Prisma (Postgres)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/with-env.mjs prisma generate --schema=db/schema.prisma",
    "db:migrate": "node scripts/with-env.mjs prisma migrate dev --schema=db/schema.prisma",
    "db:migrate:deploy": "node scripts/with-env.mjs prisma migrate deploy --schema=db/schema.prisma",
    "db:studio": "node scripts/with-env.mjs prisma studio --schema=db/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^20.19.1",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^8.57.1",
    "prisma": "^6.10.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
