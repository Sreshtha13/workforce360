# Server
NODE_ENV=development
PORT=4000
# Comma-separated frontend origins (credentials/cookies require an exact match in production)
# In development, any http://localhost:<port> is also allowed automatically.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# PostgreSQL (Supabase-hosted or local). Required — never expose to /apps/web.
DATABASE_URL=postgresql://postgres:password@localhost:5432/workforce360?schema=public

# Auth (Phase 1: JWT access + refresh in httpOnly cookies)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECURE=false

# Google OAuth (optional - leave empty if not using)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=false

# File storage (Phase 2)
# local = dev uploads to apps/api/.uploads via presigned backend URL
# s3 = AWS S3 or Supabase Storage (S3-compatible endpoint)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
