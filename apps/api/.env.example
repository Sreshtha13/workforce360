# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Supabase-hosted or local). Required — never expose to /apps/web.
DATABASE_URL=postgresql://postgres:password@localhost:5432/workforce360?schema=public

# Auth (Phase 0 decision: JWT access + refresh in httpOnly cookies)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
