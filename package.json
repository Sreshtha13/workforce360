{
  "name": "workforce360",
  "version": "0.1.0",
  "private": true,
  "description": "Workforce 360 ERP — monorepo (Next.js web + Express API)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "build": "npm run build -w api && npm run build -w web",
    "build:web": "npm run build -w web",
    "build:api": "npm run build -w api",
    "lint": "npm run lint -w web && npm run lint -w api",
    "lint:web": "npm run lint -w web",
    "lint:api": "npm run lint -w api",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w api",
    "typecheck:web": "npm run typecheck -w web",
    "typecheck:api": "npm run typecheck -w api",
    "db:generate": "npm run db:generate -w api",
    "db:migrate": "npm run db:migrate -w api"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/server": "^1.4.0"
  }
}
